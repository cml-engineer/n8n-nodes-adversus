{
	"name": "n8n-nodes-adversus",
	"version": "0.1.0",
	"description": "Work with contacts, leads, campaigns, pools and fields in Adversus",
	"license": "MIT",
	"homepage": "https://www.adversus.io",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Christian Lund",
		"email": "cml@adversus.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cml-engineer/n8n-nodes-adversus.git"
	},
	"bugs": {
		"url": "https://github.com/cml-engineer/n8n-nodes-adversus/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test tests/*.test.cjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AdversusApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Adversus/Adversus.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.16"
	},
	"private": true
}
